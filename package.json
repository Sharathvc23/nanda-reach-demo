{
  "name": "nanda-reach-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A personal agent (Poppy) registered in the NANDA Index, a merchant that keeps only its locator, and a promotion that still finds the right inbox after the person updates their card.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "start:travel26": "node dist/main-travel26.js",
    "start:mymuse": "node dist/main-mymuse.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "tsx scripts/setup-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.3.2",
    "jose": "^6.2.17",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
