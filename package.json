{
  "name": "nanda-reach-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A merchant discovers a person's agent through the NANDA Index, keeps only the locator, and still reaches the right agent after the person updates their agent card.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
