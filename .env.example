# Copy to .env.live (or set on Railway). scripts/setup-live.ts writes this file for you.
MODE=live
PORT=8095
PUBLIC_BASE_URL=https://your-service.up.railway.app
INDEX_BASE_URL=https://api.nandaindex.org
INKBOX_BASE_URL=https://inkbox.ai/api/v1
# John's NANDA locator: urn:air:host39.org:personal:<his Muse InkBox address>
JOHN_LOCATOR=urn:air:host39.org:personal:johnmuse@inkboxmail.com
JOHN_MUSE_ADDRESS=johnmuse@inkboxmail.com
JOHN_MUSE_API_KEY=
JOHN_WAJO_ADDRESS=johnwajo@inkboxmail.com
JOHN_WAJO_API_KEY=
TRAVEL26_ADDRESS=travel26@inkboxmail.com
TRAVEL26_API_KEY=
# Required for the acts (card flip, promotion, reset) when set. Leave empty for open local runs.
ADMIN_TOKEN=
# Where state.json lives. On Railway, mount a volume here to keep state across deploys.
DATA_DIR=./data
