# Two services, two environments. scripts/setup-live.ts writes .env.live for you.
# Shared by both services
MODE=live                                   # live (default) or mock (tests/local only)
INDEX_BASE_URL=https://api.nandaindex.org
INKBOX_BASE_URL=https://inkbox.ai/api/v1
ADMIN_TOKEN=                                # required for sending/chatting/resetting when set
DATA_DIR=./data                             # on Railway: /data on a volume, or leave ephemeral

# travel26 service (node dist/main-travel26.js)
PORT=8095
PUBLIC_BASE_URL=https://travel26-xxxx.up.railway.app
TRAVEL26_ADDRESS=travel26demo@inkboxmail.com
TRAVEL26_API_KEY=

# mymuse service (node dist/main-mymuse.js)
# PORT=8096
# PUBLIC_BASE_URL=https://mymuse-xxxx.up.railway.app
MYMUSE_ADDRESS=johnmusedemo@inkboxmail.com   # the agent's own InkBox mailbox; John's locator derives from it
MYMUSE_API_KEY=
WAJO_ADDRESS=johnwajodemo@inkboxmail.com     # John's second agent's mailbox
WAJO_API_KEY=                                # only needed to show the Wajo inbox in the console
JOHN_LOCATOR=urn:air:host39.org:personal:johnmusedemo@inkboxmail.com
TRAVEL26_URL=https://travel26-xxxx.up.railway.app
SHARE_LOCATOR=true                           # let companies with the nandaindex.org/reach extension keep the locator
ANTHROPIC_API_KEY=                           # model API key; set it to run the LLM brain, unset falls back to the scripted brain
AGENT_MODEL=claude-opus-5-5
# AGENT_BRAIN=llm|scripted                # override the automatic choice
